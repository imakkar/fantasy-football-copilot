# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Data artifacts (regenerated by the pipeline; not committed)
data/raw/
data/processed/
data/chroma/

# Generated outputs (large/regenerated) are ignored, but the committed sample
# outputs under outputs/ (samples.txt, sample_generations.json, README.md) are
# force-added as milestone evidence -- see `git add -f`.
outputs/*
!outputs/samples.txt
!outputs/sample_generations.json
!outputs/evaluation_results.csv
!outputs/README.md

